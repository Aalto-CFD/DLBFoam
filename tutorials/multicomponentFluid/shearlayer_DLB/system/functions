FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      functions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeFunc    time(name=cpuTime, perTimeStep=yes)
#includeFunc Qdot(executeControl=timeStep, executeInterval=1)

#includeFunc    volIntegrate(
    fields=(Qdot),
    name=total_Qdot
)

#includeFunc cellMax
(
    name=pTMax,
    fields=(p T)
)

#includeFunc volAverage
(
    name=pTAvg,
    fields=(p T)
)

