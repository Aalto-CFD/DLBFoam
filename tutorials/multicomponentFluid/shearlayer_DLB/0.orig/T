FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

#include "initialisationSetup"

internalField
{
    type coded;

    evaluate
    #{
        const scalarField y = C.component(vector::Y);
        const scalar L = $L;
        const scalar ro = $ro;
        const scalar B = $B;
        const scalar T_i = $T_i;
        const scalar T_A = $T_A;

        const scalarField dist = max(mag(y - L/2.0), scalar(VSMALL));

        const scalarField T =
            T_i
          - T_A*0.5
           *(1.0 - tanh(B*(dist/ro - ro/dist)));

        field.primitiveFieldRef() = T;
    #};
}

boundaryField
{

    upperBoundary
    {
        type            cyclic;
    }

    lowerBoundary
    {
        type            cyclic;
    }

    leftBoundary
    {
        type            cyclic;
    }

    rightBoundary
    {
        type            cyclic;
    }

    frontAndBack
    {
        type            empty;
    }

}


