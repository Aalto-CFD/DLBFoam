FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      N2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

// Common setup variables are shared in 0.orig/initialisationSetup
#include "initialisationSetup"

internalField
{
    type coded;

    evaluate
    #{
        const scalarField y(C.primitiveField().component(vector::Y));
        const scalar L = $L;
        const scalar ro = $ro;
        const scalar B = $B;
        const scalar N2_i = $N2_i;

        const scalarField dist = max(mag(y - L/2.0), scalar(VSMALL));

        const scalarField N2 =
            N2_i
          - N2_i*0.5
           *(1.0 - tanh(B*(dist/ro - ro/dist)));

        field.primitiveFieldRef() = N2;
    #};
}
boundaryField
{
    upperBoundary
    {
        type            cyclic;
    }

    lowerBoundary
    {
        type            cyclic;
    }

    leftBoundary
    {
        type            cyclic;
    }

    rightBoundary
    {
        type            cyclic;
    }

    frontAndBack
    {
        type            empty;
    }

}


