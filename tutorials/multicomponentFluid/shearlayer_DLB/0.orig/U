FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

#include "initialisationSetup"

internalField
{
    type coded;

    evaluate
    #{
        const scalarField y(C.primitiveField().component(vector::Y));
        const scalarField x(C.primitiveField().component(vector::X));
        const scalar L = $L;
        const scalar ro = $ro;
        const scalar B = $B;
        const scalar Umax = $Umax;
        const scalar UyScale = $UyScale;

        const scalarField dist = max(mag(y - L/2.0), scalar(VSMALL));

        const scalarField Ux =
            Umax*0.5
           *(1.0 - tanh(B*(dist/ro - ro/dist)));

        const scalarField Uy =
            (Umax/UyScale)
           *sin(2.0*constant::mathematical::pi*x/(L/2.0));

        vectorField U(y.size(), vector::zero);
        U.replace(vector::X, Ux);
        U.replace(vector::Y, Uy);

        field.primitiveFieldRef() = U;
    #};
}

boundaryField
{
    upperBoundary
    {
        type            cyclic;
    }

    lowerBoundary
    {
        type            cyclic;
    }

    leftBoundary
    {
        type            cyclic;
    }

    rightBoundary
    {
        type            cyclic;
    }
    frontAndBack
    {
        type            empty;
    }
}
