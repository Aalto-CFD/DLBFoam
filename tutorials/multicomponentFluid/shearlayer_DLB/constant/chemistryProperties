FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
type    loadBalanced;

//- You can use this entry to restrict the chemistry computation to a cellZone.
//- In this particular example, the "reactionZone" cellZone is not a geometric
//- zone, but instead a function of mixture fraction field. Implementation can be
//- found in system/functions.
/*
cellZone
{
    type lookup;
    name reactionZone;
}
*/
refmapping
{
    active          true;
    field           Z;
    min             0;
    max             1e-4;
}

chemistry       on;

initialChemicalTimeStep 1e-7;

loadbalancing
{
	active	true;
    log     true;
}


ode
{
    solver          seulex;
    absTol          1e-08;
    relTol          1e-05;
}

#include "$FOAM_CASE/constant/reactionsYao"
// ************************************************************************* //
